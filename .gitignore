.DS_Store

# Dependencies & generated
/vendor/
/node_modules/
/uploads/*
!/uploads/.gitkeep
/system/storage/cache/*
/system/storage/smarty/cache/*
/system/storage/smarty/compiled/*
/system/storage/temporary/*
!**/.gitkeep

# Local environment config (contains credentials)
system/configurations/cc_env.inc
tests/config/cc_env.inc
.env

# Generated by the installer / test runner
populate.sql
.phpunit.result.cache
.phpunit.cache/
phpunit.xml
